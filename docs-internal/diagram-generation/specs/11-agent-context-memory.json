{
  "id": "11-agent-context-memory",
  "title": "Agent Context vs. Simple Memory",
  "subtitle": "Automatic replay continuity and explicit durable knowledge are separate systems",
  "category": "architecture",
  "diagramType": "side-by-side-comparison",
  "description": "Agent Context is the system-managed exact journal, provider binding, replay checkpoint, and context-pressure policy connected through input-context. Simple Memory is a separate explicit tool connected through input-tools; the model or a human chooses when to remember, recall, update, or forget versioned facts in an isolated namespace, and those items are never injected as automatic transcript replay.",
  "sourceReview": "reviewed",
  "sourceRefs": [
    {
      "path": "server/nodes/context/__init__.py",
      "reason": "Defines the visible system-managed Context policy node, output-context handle, compaction policy, and metadata-only output."
    },
    {
      "path": "server/nodes/context/_descriptor.py",
      "reason": "Defines generation-scoped Context descriptors, thread selection, and delegated-task isolation."
    },
    {
      "path": "server/services/agent_context/store.py",
      "reason": "Defines transactional append-only Context threads, epochs, revisions, journal events, and checkpoints."
    },
    {
      "path": "server/services/agent_context/compaction.py",
      "reason": "Defines provider-native versus portable compaction and exact replay-tail behavior under context pressure."
    },
    {
      "path": "server/nodes/context/_handlers.py",
      "reason": "Defines active-epoch journal inspection so Reset and Clear expose the fresh live epoch while retaining prior events as archived history."
    },
    {
      "path": "server/nodes/tool/simple_memory/__init__.py",
      "reason": "Defines Simple Memory V2 as an explicit locked-schema tool with remember, recall, list, get, update, and forget operations."
    },
    {
      "path": "server/services/memory/tool_store.py",
      "reason": "Defines isolated owner/workflow/node namespaces, versioned durable items, idempotent mutations, and lexical or embedding retrieval."
    },
    {
      "path": "client/src/components/parameterPanel/ContextPanel.tsx",
      "reason": "Defines the authorized exact-journal and active-replay inspector, including pressure, checkpoints, fork, export, and epoch clear."
    },
    {
      "path": "client/src/components/parameterPanel/MemoryToolPanel.tsx",
      "reason": "Defines human-authored durable facts, search, update, forget, and isolated bulk-clear controls."
    }
  ],
