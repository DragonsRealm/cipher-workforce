{
  "id": "09-credentials-architecture",
  "title": "Credentials Architecture",
  "subtitle": "Server-owned catalogue, WebSocket orchestration, and encrypted storage",
  "category": "architecture",
  "diagramType": "layered-security-data-flow",
  "description": "Credential configuration flows from the server-owned provider catalogue through modular client panels and registered WebSocket handlers. AuthService is the only plaintext access boundary; CredentialsDatabase encrypts separate API-key and OAuth-token records with the process-held Fernet service, while status events invalidate every connected client's catalogue.",
  "sourceReview": "reviewed",
  "sourceRefs": [
    {
      "path": "client/src/components/credentials/CredentialsModal.tsx",
      "reason": "Defines the thin modal shell, server-owned catalogue consumption, searchable palette, and lazy panel dispatch."
    },
    {
      "path": "client/src/components/credentials/useCredentialPanel.ts",
      "reason": "Defines per-provider TanStack Query state and credential RPC actions without persisting plaintext in the UI store."
    },
    {
      "path": "server/services/credentials/handlers.py",
      "reason": "Implements registered validate, get, save, and delete WebSocket handlers and their mutation broadcasts."
    },
    {
      "path": "server/services/plugin/credential.py",
      "reason": "Defines declarative credential classes, provider-specific probes, runtime resolution, and validation dispatch."
    },
    {
      "path": "server/services/auth.py",
      "reason": "Defines the sole credential access service, separate API-key and OAuth caches, catalogue invalidation, and refresh-token non-caching rule."
    },
    {
      "path": "server/core/credentials_database.py",
      "reason": "Defines the canonical encrypted SQLite records, two-table storage split, and calls to EncryptionService."
    },
    {
      "path": "server/core/encryption.py",
      "reason": "Defines PBKDF2-SHA256 key derivation and the process-held Fernet encrypt/decrypt boundary."
    },
    {
      "path": "server/services/status_broadcaster.py",
      "reason": "Defines api_key_status and credential_catalogue_updated broadcasts consumed by connected clients."
    }
  ],
