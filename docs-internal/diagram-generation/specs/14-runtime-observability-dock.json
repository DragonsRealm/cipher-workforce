{
  "id": "14-runtime-observability-dock",
  "title": "Runtime Observability Dock",
  "subtitle": "One resizable dock combines workflow chat, Console-node output, and live server/process logs without conflating their scopes.",
  "category": "product-panel",
  "diagramType": "runtime observability product panel and stream topology",
  "description": "Source-backed topology of the collapsible Chat / Console dock: chat messages, Console node records, and terminal logs use distinct producers and retention paths, converge in WebSocketContext state, and render in a resizable chat pane plus Console and Terminal tabs with targeted filters and clear actions.",
  "sourceReview": "reviewed",
  "sourceRefs": [
    {
      "path": "client/src/components/ui/ConsolePanel.tsx",
      "reason": "Defines the collapsible, resizable Chat / Console dock, chat target selector, Console and Terminal tabs, filters, clear controls, auto-scroll, pretty-print, and persisted preferences."
    },
    {
      "path": "client/src/contexts/WebSocketContext.tsx",
      "reason": "Owns live chat/console/terminal arrays, reconnect and workflow-switch hydration, clear commands, send_chat_message, and 100/200-entry client caps."
    },
    {
      "path": "server/nodes/utility/console/__init__.py",
      "reason": "Produces structured Console-node log records and broadcasts them while passing workflow data through."
    },
    {
      "path": "server/services/status_broadcaster.py",
      "reason": "Persists and broadcasts Console logs, retains the last 100 in memory, and retains/broadcasts the last 200 Terminal logs."
    },
    {
      "path": "server/routers/websocket.py",
      "reason": "Defines workflow-scoped chat send/history/clear, Console history/clear, and Terminal history/clear request handlers."
    },
    {
      "path": "server/nodes/trigger/chat_trigger/_events.py",
      "reason": "Dispatches workflow-scoped chat_message_received CloudEvents to waiting chatTrigger consumers and the frontend."
    },
    {
      "path": "server/services/process_service.py",
      "reason": "Streams managed-process output into the Terminal log channel."
    },
    {
      "path": "server/core/logging.py",
      "reason": "Streams server logger records into the Terminal log broadcaster."
    },
    {
      "path": "docs-internal/node-logic-flows/chat_utility/console.md",
      "reason": "Documents the reviewed Console node record shape and StatusBroadcaster side effect consumed by the dock."
    }
  ],
