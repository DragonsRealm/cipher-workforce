{
  "id": "10-team-operations",
  "title": "Team Operations",
  "subtitle": "Execution-scoped durable tasks: assign, run, review, recover, and finish",
  "category": "architecture",
  "diagramType": "state-machine-and-control-surfaces",
  "description": "A team lead uses its intrinsic Task Manager to persist bounded work for graph-connected teammates. AgentTeamService enforces workflow, lead, execution, assignee, and optimistic-revision boundaries while tasks advance from blocked or queued through worker submission and explicit lead acceptance; Task Manager and Team Monitor expose mutable and read-only views of the same durable state.",
  "sourceReview": "reviewed",
  "sourceRefs": [
    {
      "path": "server/nodes/tool/task_manager/__init__.py",
      "reason": "Defines the intrinsic model-facing operations, connected-teammate resolution, and trusted execution scope."
    },
    {
      "path": "server/services/agent_team.py",
      "reason": "Defines durable assignment, authorized mutation transitions, submission versus acceptance semantics, and finish-team gating."
    },
    {
      "path": "server/services/agent_teams/handlers.py",
      "reason": "Defines human WebSocket reads and revision-checked task management operations."
    },
    {
      "path": "server/services/temporal/agent_workflow.py",
      "reason": "Implements detached delegated task execution, concurrency permits, child completion, and terminal cleanup."
    },
    {
      "path": "client/src/components/parameterPanel/TaskManagerPanel.tsx",
      "reason": "Defines the operational task UI, status-specific actions, revision checks, execution history, and Temporal trace inspection."
    },
    {
      "path": "client/src/components/parameterPanel/TeamMonitorPanel.tsx",
      "reason": "Defines the read-only teammate and task snapshot, lifecycle counts, execution selector, and event-driven refresh."
    }
  ],
