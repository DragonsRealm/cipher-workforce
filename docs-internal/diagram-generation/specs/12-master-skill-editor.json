{
  "id": "12-master-skill-editor",
  "title": "Master Skill Editor",
  "subtitle": "One split panel joins the skill catalogue, authoritative instructions, node configuration, and live retrieval state.",
  "category": "product-panel",
  "diagramType": "product panel with configuration and runtime data flow",
  "description": "Source-backed anatomy of the Master Skill editor: built-in and user skill sources flow through WebSocket handlers and TanStack caches into the catalogue and instruction editor, while enabled skills persist in skills_config, expand for a connected agent, and report safe runtime badges back to the exact Master Skill row.",
  "sourceReview": "reviewed",
  "sourceRefs": [
    {
      "path": "client/src/components/parameterPanel/MasterSkillEditor.tsx",
      "reason": "Defines the split catalogue/editor surface, folder and user-skill queries, enable toggles, instruction editing, CRUD actions, skills_config writes, and runtime row badges."
    },
    {
      "path": "client/src/hooks/useFolderSkills.ts",
      "reason": "Defines the folderSkills TanStack query and scan_skill_folder metadata mapping used by the catalogue."
    },
    {
      "path": "server/services/skills/handlers.py",
      "reason": "Owns the list/scan/content handlers, user-skill CRUD, and lifecycle-producing mutation paths used by the editor."
    },
    {
      "path": "server/nodes/skill/master_skill/__init__.py",
      "reason": "Defines the passive Master Skill node, required assistant Skill entry, skills_config parameter shape, and editor UI hints."
    },
    {
      "path": "server/nodes/skill/_expander.py",
      "reason": "Expands enabled skills_config entries into per-skill descriptors for connected agents."
    },
    {
      "path": "server/services/skill_runtime.py",
      "reason": "Loads authoritative instructions progressively and publishes loading, loaded, used, or failed activity to the agent and exact Master Skill node."
    },
    {
      "path": "server/nodes/skill/master_skill/_events.py",
      "reason": "Defines the skill_lifecycle CloudEvent used to invalidate userSkills, folderSkills, and skillContent caches across clients."
    },
    {
      "path": "client/src/contexts/WebSocketContext.tsx",
      "reason": "Routes skill_lifecycle invalidation and live node-status data consumed by the editor."
    }
  ],
