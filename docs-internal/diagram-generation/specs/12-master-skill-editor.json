  "callouts": [
    {
      "id": "master-skill-invariant",
      "x": 70,
      "y": 880,
      "w": 1780,
      "h": 90,
      "title": "Configuration is authoritative; observability is sanitized",
      "lines": [
        "skills_config keeps the enabled flag and instruction body used by the connected agent.",
        "Runtime events expose names and states only—never prompts, arguments, results, secrets, or raw exceptions."
      ]
    }
  ],
  "prompt": {
    "primaryRequest": "Draw a source-backed product-panel schematic of the Master Skill Editor, showing its split skill catalogue and instructions editor, the built-in and user skill sources, the persisted skills_config, expansion into the connected Agent Skill runtime, and the safe runtime-status feedback loop.",
    "composition": "Use three clearly bounded vertical zones matching the supplied coordinates: source handlers on the left, the split editor and its view/config state in the center, and the connected agent runtime on the right. Keep the bottom status-feedback route outside the cards and reserve the final band for the invariant callout.",
    "constraints": [
      "Show the Skills catalogue pane and Instructions editor pane as equal peers in one editor surface",
      "Keep built-in SKILL.md content distinct from database-backed user skills",
      "Show skills_config as the authoritative enabled/instructions configuration, not a runtime log",
      "Show the runtime feedback arrow returning to the matching catalogue row",
      "Use the exact handler/cache/config/runtime labels supplied in the spec"
    ],
    "avoid": [
      "generic prompt-engineering imagery",
      "implying every skill body is eagerly injected into the system prompt",
      "showing runtime events that contain instruction text or secrets",
      "merging built-in files and user skills into one storage box"
    ]
  }
